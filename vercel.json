{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { 
        "maxLambdaSize": "100mb",
        "distDir": "build" 
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": { 
        "maxLambdaSize": "100mb" 
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ]
}